{
  "name": "my-first-extension",
  "displayName": "my-first-extension",
  "description": "My first VS Code extension",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/chikchikit/my-first-extension.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionDependencies": ["vscode.git"],
  "contributes": {
  "commands": [
    {
      "command": "my-first-extension.helloWorld",
      "title": "Hello World"
    },
    {
      "command": "my-first-extension.generateCommitMessage",
      "title": "Generate Commit Message",
      "category": "Commit Assistant",
      "icon": "$(sparkle)"
    },
    {
      "command": "my-first-extension.refreshChanges",
      "title": "Refresh Changes",
      "category": "Commit Assistant",
      "icon": "$(refresh)"
    },
    {
      "command": "my-first-extension.commitSelected",
      "title": "Commit Selected",
      "category": "Commit Assistant",
      "icon": "$(check)"
    }
  ],
  "keybindings": [
    {
      "command": "my-first-extension.generateCommitMessage",
      "key": "ctrl+alt+g",
      "mac": "cmd+alt+g"
    }
  ],
  "viewsContainers": {
    "activitybar": [
      {
        "id": "commitAssistant",
        "title": "Commit Assistant",
        "icon": "$(sparkle)"
      }
    ]
  },
  "views": {
    "commitAssistant": [
      {
        "id": "commitAssistant.changes",
        "name": "Изменения"
      }
    ]
  },
  "viewsWelcome": [
    {
      "view": "commitAssistant.changes",
      "contents": "Изменений не найдено. Измените файл в git-репозитории и нажмите кнопку.\n[Обновить](command:my-first-extension.refreshChanges)"
    }
  ],
  "menus": {
    "scm/title": [
      {
        "command": "my-first-extension.generateCommitMessage",
        "when": "scmProvider == git",
        "group": "navigation"
      }
    ],
    "view/title": [
      {
        "command": "my-first-extension.refreshChanges",
        "when": "view == commitAssistant.changes",
        "group": "navigation@1"
      },
      {
        "command": "my-first-extension.commitSelected",
        "when": "view == commitAssistant.changes",
        "group": "navigation@2"
      }
    ]
  }
},
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
